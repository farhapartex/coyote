:root {
  --brand: #00ADD8;
  --ink: #1b1f23;
  --muted: #6a737d;
  --line: #e4e8ec;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  font: 16px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  color: var(--ink);
  background: #fff;
}

header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem 2rem;
  border-bottom: 1px solid var(--line);
}

.brand {
  font-weight: 600;
  font-size: 1.1rem;
  color: var(--brand);
  text-decoration: none;
}

nav a {
  color: var(--muted);
  text-decoration: none;
  margin-left: 1rem;
}

nav a:hover { color: var(--brand); }

main {
  max-width: 46rem;
  margin: 0 auto;
  padding: 3rem 2rem;
}

h1 { margin-top: 0; }

code {
  background: #f4f6f8;
  border-radius: 4px;
  padding: 0.1rem 0.35rem;
  font-size: 0.9em;
}

.flash {
  padding: 0.75rem 1rem;
  border-radius: 6px;
  border-left: 3px solid var(--brand);
  background: #f4fbfd;
}

.flash-error { border-left-color: #d73a49; background: #fdf3f4; }

footer {
  max-width: 46rem;
  margin: 0 auto;
  padding: 2rem;
  color: var(--muted);
  font-size: 0.875rem;
  border-top: 1px solid var(--line);
}
